<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane xmlns="http://javafx.com/javafx/20.0.2"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.payroll_management.Salary_CalculatorController"
            fx:id="anchorPane"
            prefHeight="775.0" prefWidth="727.0">

    <children>
        <Label layoutX="23.0" layoutY="45.0" text="Payroll Management System">
            <font>
                <Font size="40.0" />
            </font>
        </Label>

        <!-- Navigation Menu -->
        <Label fx:id="dashboard" layoutX="70.0" layoutY="148.0" text="Dashboard" onMouseClicked="#goToDashboard" />
        <Label fx:id="employees" layoutX="70.0" layoutY="183.0" text="Employees" onMouseClicked="#goToEmployees" />
        <Label fx:id="calculator" layoutX="70.0" layoutY="220.0" text="Salary Calculator" onMouseClicked="#goToSalaryCalculator" />
        <Label fx:id="payslip" layoutX="70.0" layoutY="260.0" text="Payslip" onMouseClicked="#goToPayslip" />
        <Label fx:id="reports" layoutX="70.0" layoutY="293.0" text="Reports" onMouseClicked="#goToReports" />

        <!-- Salary Calculator UI -->
        <Label layoutX="197.0" layoutY="125.0" text="Salary Calculator">
            <font>
                <Font size="28.0" />
            </font>
        </Label>

        <Button fx:id="logout" layoutX="646.0" layoutY="62.0" mnemonicParsing="false"
                onAction="#logout" text="Logout" />

        <Label layoutX="209.0" layoutY="178.0" text="Employee Selection">
            <font>
                <Font size="18.0" />
            </font>
        </Label>
        <Label layoutX="215.0" layoutY="205.0" text="Select Employee (Optional)" />
        <ComboBox fx:id="employeeComboBox" layoutX="212.0" layoutY="229.0" prefWidth="150.0" />

        <!-- Calculator components -->
        <Label layoutX="209.0" layoutY="280.0" text="Salary Components">
            <font>
                <Font size="18.0" />
            </font>
        </Label>

        <Label layoutX="213.0" layoutY="319.0" text="Basic Salary(R)" />
        <TextField fx:id="basicSalaryField" layoutX="209.0" layoutY="335.0" />

        <Label layoutX="209.0" layoutY="374.0" text="Working Hours" />
        <TextField fx:id="workingHoursField" layoutX="209.0" layoutY="391.0" />

        <Label layoutX="209.0" layoutY="431.0" text="Overtime Hours" />
        <TextField fx:id="overtimeHoursField" layoutX="209.0" layoutY="448.0" />

        <Label fx:id="overtimeRateLabel" layoutX="218.0" layoutY="480.0" text="Overtime Rate: 1.5x" />
        <Slider fx:id="overtimeRateSlider" layoutX="209.0" layoutY="500.0" min="1.0" max="3.0" value="1.5" />

        <Label layoutX="215.0" layoutY="535.0" text="Deductions">
            <font>
                <Font size="18.0" />
            </font>
        </Label>

        <Label fx:id="taxRateLabel" layoutX="209.0" layoutY="575.0" text="Tax Rate: 20.0%" />
        <Slider fx:id="taxRateSlider" layoutX="209.0" layoutY="595.0" min="0" max="50" value="20" />

        <Label fx:id="insuranceRateLabel" layoutX="209.0" layoutY="622.0" text="Insurance Rate: 5.0%" />
        <Slider fx:id="insuranceRateSlider" layoutX="209.0" layoutY="642.0" min="0" max="20" value="5" />

        <Label layoutX="209.0" layoutY="660.0" text="Other Deductions (R)" />
        <TextField fx:id="otherDeductionsField" layoutX="209.0" layoutY="683.0" />

        <!-- Results Section -->
        <TextArea fx:id="resultsArea" layoutX="471.0" layoutY="214.0" prefHeight="500.0" prefWidth="230.0"
                  editable="false" wrapText="true" />

        <Button fx:id="resetButton" layoutX="376.0" layoutY="723.0" mnemonicParsing="false"
                onAction="#handleReset" prefHeight="25.0" prefWidth="52.0" text="Reset" />
    </children>
</AnchorPane>