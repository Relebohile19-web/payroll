<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane fx:id="anchorPane" prefHeight="600.0" prefWidth="900.0"
            style="-fx-background-color: #ffffff;"
            xmlns="http://javafx.com/javafx/20.0.2" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.payroll_management.Employee_dashboardController">

   <!-- Sidebar -->
   <AnchorPane fx:id="sidebar" layoutX="0.0" layoutY="0.0" prefHeight="600.0" prefWidth="200.0"
               style="-fx-background-color: #f9e7f2; -fx-border-color: #e0e0e0; -fx-border-width: 0 1 0 0;">

      <!-- App Name -->
      <Label fx:id="appName" layoutX="20.0" layoutY="20.0" prefHeight="30.0" prefWidth="160.0"
             text="Salary Swift"
             style="-fx-text-fill: #e91e63; -fx-font-family: 'Arial'; -fx-font-weight: bold; -fx-font-size: 18;" />

      <!-- Navigation Labels with Icons -->
      <Label fx:id="salaryDetails" layoutX="20.0" layoutY="70.0" prefHeight="30.0" prefWidth="160.0"
             text=" Salary Details"
             style="-fx-text-fill: #333; -fx-font-family: 'Arial'; -fx-font-size: 14; -fx-background-color: #f5d6e6; -fx-background-radius: 5; -fx-padding: 0 0 0 30;">
         <graphic>
            <Label text="💰" style="-fx-font-size: 14; -fx-text-fill: #333;" />
         </graphic>
      </Label>

      <Label fx:id="payslips" layoutX="20.0" layoutY="110.0" prefHeight="30.0" prefWidth="160.0"
             text=" Payslips"
             style="-fx-text-fill: #333; -fx-font-family: 'Arial'; -fx-font-size: 14; -fx-padding: 0 0 0 30;">
         <graphic>
            <Label text="💵" style="-fx-font-size: 14; -fx-text-fill: #333;" />
         </graphic>
      </Label>

      <!-- Logout Button at Bottom -->
      <Button fx:id="logout" layoutX="20.0" layoutY="560.0" prefHeight="30.0" prefWidth="160.0"
              text="Logout"
              style="-fx-background-color: #e91e63; -fx-text-fill: #ffffff; -fx-font-family: 'Arial'; -fx-font-size: 14; -fx-background-radius: 15;"/>
   </AnchorPane>

   <!-- Main Content Area -->
   <!-- Salary Details Section -->
   <Label fx:id="welcomeLabel" layoutX="220.0" layoutY="30.0" prefHeight="30.0" prefWidth="300.0"
          text="Welcome, Employee"
          style="-fx-text-fill: #e91e63; -fx-font-family: 'Arial'; -fx-font-size: 24;" />

   <Label fx:id="basicSalary" layoutX="220.0" layoutY="80.0" prefHeight="50.0" prefWidth="150.0"
          text="R0"
          style="-fx-text-fill: #333; -fx-font-family: 'Arial'; -fx-font-size: 20; -fx-font-weight: bold; -fx-alignment: center; -fx-background-color: #fff0f6; -fx-border-color: #e0e0e0; -fx-border-radius: 10; -fx-padding: 10;" />
   <Label layoutX="220.0" layoutY="60.0" prefHeight="20.0" prefWidth="150.0"
          text="Basic Salary"
          style="-fx-text-fill: #666; -fx-font-family: 'Arial'; -fx-font-size: 14; -fx-alignment: center;" />

   <!-- Payslips Table (Initially Hidden) -->
   <TableView fx:id="payslipTable" layoutX="220.0" layoutY="150.0" prefHeight="400.0" prefWidth="600.0" visible="false">
      <columns>
         <TableColumn fx:id="monthColumn" prefWidth="100.0" text="Month" />
         <TableColumn fx:id="yearColumn" prefWidth="100.0" text="Year" />
         <TableColumn fx:id="basicSalaryColumn" prefWidth="150.0" text="Basic Salary" />
      </columns>
   </TableView>
</AnchorPane>